/* eslint-disable no-undef */
/**
 * WordPress dependencies
 */
import { __ } from '@wordpress/i18n';
import {
	useBlockProps,
	RichText,
	BlockControls,
} from '@wordpress/block-editor';
import {
	Placeholder,
	ToolbarGroup,
	ToolbarButton,
	TextControl,
} from '@wordpress/components';
import { useState, useEffect } from '@wordpress/element';

/**
 * Internal dependencies
 */
import { ApiImageSelect } from './components';
import MemeIcon from './icon';
import './editor.scss';

/**
 * The edit function describes the structure of your block in the context of the
 * editor. This represents what the editor will render when the block is used.
 *
 * @param  root0
 * @param  root0.attributes
 * @param  root0.setAttributes
 * @see https://developer.wordpress.org/block-editor/developers/block-api/block-edit-save/#edit
 * @return {WPElement} Element to render.
 */
export default function Edit( { attributes, setAttributes } ) {
	const blockProps = useBlockProps();
	{{#isCompletedVariant}}
	const { image, topText, bottomText } = attributes;

	// Store all the images
	const [ allImages, setAllImages ] = useState( [] );
	const [ filteredImages, setFilteredImages ] = useState( [] );
	const [ searchTerm, setSearchTerm ] = useState( '' );

	// Load the images from the API
	useEffect( () => {
		const loadImages = async () => {
			const sessionImages = sessionStorage.getItem( 'meme_images' );
			if ( sessionImages ) {
				setAllImages( JSON.parse( sessionImages ) );
			} else {
				const response = await fetch(
					'https://api.imgflip.com/get_memes'
				);
				const { success, data } = await response.json();

				if ( success ) {
					const filteredMemes = data.memes
						.filter( ( meme ) => meme.box_count === 2 )
						.map(
							( {
								captions,
								box_count: boxCount,
								...dataWeNeed
							} ) => {
								return {
									...dataWeNeed,
								};
							}
						);
					setAllImages( filteredMemes );
					setFilteredImages( filteredMemes );
					sessionStorage.setItem(
						'meme_images',
						JSON.stringify( filteredMemes )
					);
				}
			}
		};
		loadImages();
		/*
		fetch( 'https://api.imgflip.com/get_memes' )
			.then( ( response ) => response.json() )
			.then( ( data ) => {
				const images = data.data.memes.filter(
					( image ) => image.box_count === 2
				);
				setAllImages( images );
				setFilteredImages( images );
			} );
		*/
	}, [] );

	// Filter the Meme based on the search term
	useEffect( () => {
		const searchTermLower = searchTerm.toLowerCase();
		const filtered = allImages.filter( ( meme ) =>
			meme.name.toLowerCase().includes( searchTermLower )
		);
		setFilteredImages( filtered );
	}, [ searchTerm, allImages ] );

	// If we don't have an image, show this.
	if ( ! image ) {
		return (
			<section { ...blockProps }>
				<Placeholder
					icon={ <MemeIcon /> }
					instructions={ __(
						'Choose an image for your meme:',
						'twitch-steams'
					) }
					label={ __( 'Meme Generator', 'twitch-streams' ) }
				>
					<TextControl
						label={ __( 'Search', 'twitch-streams' ) }
						value={ searchTerm }
						onChange={ ( newSearchTerm ) =>
							setSearchTerm( newSearchTerm )
						}
					/>

					<ApiImageSelect
						images={ filteredImages }
						setAttributes={ setAttributes }
					/>
				</Placeholder>
			</section>
		);
	}
	{{/isCompletedVariant}}
	return (
		<>
			<section { ...blockProps }>
				<div className="meme-wrapper">
					{{^isCompletedVariant}}
					<div
						className="text-overlay text-overlay__top"
						style={ { color: 'white' } }
					>
						Top Text
					</div>
					<div
						className="text-overlay text-overlay__bottom"
						style={ { color: 'white' } }
					>
						Bottom Text
					</div>
					<img
						src="https://i.imgflip.com/1bh8.jpg"
						alt="The Most Interesting Man In The World"
					/>
					{{/isCompletedVariant}}
					{{#isCompletedVariant}}
					<RichText
						tagName="div"
						id={ `${ blockProps.id }-top-text` }
						className="text-overlay text-overlay__top"
						value={ topText }
						placeholder={ __( 'Setup', 'twitch-streams' ) }
						onChange={ ( newTopText ) =>
							setAttributes( { topText: newTopText } )
						}
						allowedFormats={ [] }
						disableLineBreaks
					/>
					<RichText
						tagName="div"
						className="text-overlay text-overlay__bottom"
						value={ bottomText }
						placeholder={ __( 'Punchline', 'twitch-streams' ) }
						onChange={ ( newBottomText ) =>
							setAttributes( { bottomText: newBottomText } )
						}
						allowedFormats={ [] }
						disableLineBreaks
					/>
					<img src={ image.url } alt={ image.name } />
					{{/isCompletedVariant}}
				</div>
			</section>
			{{#isCompletedVariant}}
			<BlockControls>
				<ToolbarGroup>
					<ToolbarButton
						icon="remove"
						label={ __( 'Remove Meme Image', 'twitch-streams' ) }
						onClick={ () => setAttributes( { image: false } ) }
					/>
				</ToolbarGroup>
			</BlockControls>
			{{/isCompletedVariant}}
		</>
	);
}
