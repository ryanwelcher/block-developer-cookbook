{
	"name": "block-developers-cookbook",
	"version": "0.1.0",
	"description": "The home of all of the templates for The Block Developer Cookbook",
	"author": "Ryan Welcher",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"block": "cd ./plugins && npx @wordpress/create-block@latest --template ../templates/bdc --variant dynamic",
		"plugin": "cd ./plugins && npx @wordpress/create-block@latest --template ../templates/bdc --variant plugin",
		"iapi": "cd ./plugins && npx @wordpress/create-block@latest --template ../templates/bdc --variant interactive",
		"env": "wp-env",
		"prep:acronym-format": "cd plugins && npx @wordpress/create-block@latest acronym-format --template ../templates/acronym-format --category block-developer-cookbook",
		"prep:customize-build-process": "cd plugins && npx @wordpress/create-block@latest customize-build-process --template ../templates/customize-build-process  --category block-developer-cookbook",
		"prep:simple-fade-effect": "cd plugins && npx @wordpress/create-block@latest simple-fade-effect --template ../templates/simple-fade-effect --category block-developer-cookbook",
		"prep:transforms": "cd plugins && npx @wordpress/create-block@latest transforms --template ../templates/transforms --category block-developer-cookbook",
		"prep:post-meta-testimonial": "cd plugins && npx @wordpress/create-block@latest post-meta-testimonial --template ../templates/testimonial --category block-developer-cookbook",
		"prep:gallery-slider": "cd plugins && npx @wordpress/create-block@latest gallery-slider --template ../templates/gallery-slider --category block-developer-cookbook",
		"prep:tape-style": "cd plugins && npx @wordpress/create-block@latest tape-style --template ../templates/tape-style --category block-developer-cookbook",
		"prep:editorial-notes": "cd plugins && npx @wordpress/create-block@latest editorial-notes --template ../templates/editorial-notes --category block-developer-cookbook",
		"prep:word-counter": "cd plugins && npx @wordpress/create-block@latest word-counter --template ../templates/word-counter --category block-developer-cookbook",
		"prep:deprecations": "cd plugins && npx @wordpress/create-block@latest recipe-block-deprecations --template ../templates/recipe-block-deprecations --category block-developer-cookbook",
		"prep:preset-block-bindings": "cd plugins && npx @wordpress/create-block@latest preset-block-bindings --template ../templates/preset-block-bindings --category block-developer-cookbook",
		"prep:bound-excerpt": "cd plugins && npx @wordpress/create-block@latest bound-excerpt --template ../templates/bound-excerpt --category block-developer-cookbook",
		"prep:dark-light-mode": "cd plugins && npx @wordpress/create-block@latest dark-light-mode --template ../templates/dark-light-mode --category block-developer-cookbook",
		"prep:your-people": "cd plugins && npx @wordpress/create-block@latest your-people --template ../templates/your-people --category block-developer-cookbook",
		"prep:meme-generator": "cd plugins && npx @wordpress/create-block@latest meme-generator --template ../templates/meme-generator --category block-developer-cookbook",
		"prep:custom-social-icons": "cd plugins && npx @wordpress/create-block@latest custom-social-icons --template ../templates/custom-social-icons --category block-developer-cookbook"
	},
	"devDependencies": {
		"@wordpress/env": "^10.17.0",
		"@wordpress/prettier-config": "^4.17.0"
	}
}
